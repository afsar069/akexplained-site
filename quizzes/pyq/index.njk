{# Rule 3 hub page; made from _data/pyqHub.js so the NET card counts itself (CLAUDE.md rule 19). #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Previous Year Questions | AK Explained</title>
<meta name="description" content="Previous-year question papers by exam. Take UGC-NET English and UP PGT English papers as an online test; TGT is coming soon.">
<link rel="icon" href="/assets/logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/">
      <img src="/assets/logo.png" alt="AK Explained logo" width="40" height="40">
      <span>AK <i>Explained</i></span>
    </a>
    <nav class="primary-nav" aria-label="Primary">
      <span class="navitem">
        <a href="/exams/net/">UGC NET/JRF &#9662;</a>
        <span class="dd">
          <a href="/exams/net/">NET English Literature</a>
        </span>
      </span>
      <span class="navitem">
        <a href="/exams/ma-ba/">University Exams &#9662;</a>
        <span class="dd">
          <a href="/university/ccs-meerut/">CCS University Meerut</a>
          <a href="/university/ignou/">IGNOU</a>
          <a href="/university/du/">DU</a>
        </span>
      </span>
      <span class="navitem">
        <a href="/quizzes/">Quizzes &#9662;</a>
        <span class="dd">
          <a href="/quizzes/pyq/">PYQ</a>
          <a href="/quizzes/mcq/">MCQ</a>
        </span>
      </span>
      <span class="navitem">
        <a href="/publish-with-us/">Your Creativity</a>
      </span>
      <span class="navitem">
        <a href="/help/">Help &#9662;</a>
        <span class="dd">
          <a href="/contact/">Contact us</a>
        </span>
      </span>
    </nav>
  </div>
</header>

<div class="wrap"><p class="crumb"><a href="/">Home</a><span>/</span><a href="/quizzes/">Quizzes</a><span>/</span>PYQ</p></div>
<main id="main">

<section class="pagehead pagehead-practice pagehead-daily-art">
  <span class="mark" aria-hidden="true">P</span>
  <div class="wrap">
    <p class="eyebrow">Practice &middot; PYQ</p>
    <h1>Previous Year Questions</h1>
    <p class="lede">A past paper is a document about the examiner's mind. Read it in your first month, not your last.</p>
    <nav class="mcq-modes" aria-label="Practice sections">
      <a href="/quizzes/daily/">Daily Quiz</a>
      <a href="/quizzes/mcq/">MCQs</a>
      <span aria-current="page">PYQs</span>
      <a href="/quizzes/mock-tests/">Mock Tests</a>
    </nav>
  </div>
</section>


<section class="exam-pick" aria-labelledby="pyqPickTitle">
  <div class="wrap">
    <div class="sechead">
      <h2 id="pyqPickTitle">Choose Your Exam</h2>
    </div>
    <p class="seclede">Pick an exam to open its previous-year papers. Papers for the other exams will appear here as they are added.</p>
    <div class="exam-cats">
{% for c in pyqHub %}
{% if c.live %}
      <a class="exam-cat" href="{{ c.href }}">
        <span class="exam-cat-ic" aria-hidden="true"><img src="/assets/icons/feather/{{ c.icon }}.svg" alt="" width="24" height="24"></span>
        <span class="exam-cat-txt">
          <strong>{{ c.title }}</strong>
          <span>{{ c.blurb }}</span>
          <small>{{ c.meta }}</small>
        </span>
        <span class="exam-cat-go">Open</span>
      </a>
{% else %}
      <div class="exam-cat is-soon" aria-disabled="true">
        <span class="exam-cat-ic" aria-hidden="true"><img src="/assets/icons/feather/{{ c.icon }}.svg" alt="" width="24" height="24"></span>
        <span class="exam-cat-txt">
          <strong>{{ c.title }}</strong>
          <span>{{ c.blurb }}</span>
        </span>
        <span class="exam-cat-go">Coming soon</span>
      </div>
{% endif %}
{% endfor %}
    </div>
  </div>
</section>

{% set hubLinksText = "Pages that help you prepare alongside these papers." %}
{% include "hub-links.njk" %}

</main>

<footer class="site-footer">
  <div class="wrap">
    <p class="id"><img src="/assets/logo.png" alt="" width="34" height="34"><span><b>AK Explained</b> — English Literature for Indian Exams &middot; BA to UGC-NET</span></p>
    <nav aria-label="Footer">
      <a href="/">Home</a>
      <a href="/exams/">Exams</a>
      <a href="/notes/">Notes</a>
      <a href="/guides/">Guides</a>
      <a href="/quizzes/">Quizzes</a>
      <a href="/help/">Help</a>
    </nav>
    <p class="legal">
      <span>&copy; 2026 AK Explained &middot; Prof. Afsar Khan</span>
      <a href="/privacy/">Privacy Policy</a>
      <a href="/terms/">Terms</a>
    </p>
  </div>
</footer>

</body>
</html>

---
layout: pgt-layout.njk
title: UP PGT English MCQs
description: Day-wise English Literature practice.
crumb_label: MCQs
pgt_practice_index: true
pgt_practice_hero_title: English MCQs
pgt_practice_collection_label: MCQs
pgt_resources: true
---
<section class="pgt-practice-index" aria-labelledby="pgt-practice-index-title">
  <header class="pgt-practice-intro">
    <div>
      <h2 id="pgt-practice-index-title">Choose your practice day</h2>
      <p>Days 1 to 10 are open without login. Day 11 is open with a free login. More days are coming soon.</p>
    </div>
    <span>60 days</span>
  </header>
  <div class="pgt-practice-groups">
    {% for group in pgtMcqGroups %}
    <details class="pgt-practice-group"{% if loop.first %} open{% endif %}>
      <summary>
        <img class="pgt-practice-group-icon" src="/assets/icons/tabler/calendar-check.svg" alt="" width="28" height="28">
        <span>Days {{ group.startLabel }}–{{ group.endLabel }}</span>
        <small>10 days</small>
        <img class="pgt-practice-chevron" src="/assets/icons/feather/chevron-down.svg" alt="" width="22" height="22">
      </summary>
      <div class="pgt-practice-card-grid">
        {% for day in group.days %}
        {% set dayUrl = '/exams/pgt/up-pgt/mcqs/day-' ~ day.number ~ '/' %}
        {% if day.access == 'login' %}
        <div class="pgt-practice-card">
          <span class="pgt-practice-card-copy"><strong>Day {{ day.label }}</strong><span>{{ day.title }} · {{ day.questionCount }} questions · Free login required</span></span>
          <a class="agehub-go agehub-go-lock" data-guest-only hidden href="/login/?next={{ dayUrl | urlencode }}" aria-label="Day {{ day.number }} needs a login. Log in to open it." title="Log in to open Day {{ day.number }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></a>
          <a class="agehub-go is-solid" data-auth-only hidden href="{{ dayUrl }}">Start</a>
        </div>
        {% else %}
        <a class="pgt-practice-card" href="/exams/pgt/up-pgt/mcqs/day-{{ day.number }}/" aria-label="Day {{ day.number }}{% if day.access %} — {{ day.title }}, {{ day.questionCount }} questions, free, no login{% else %} — coming soon{% endif %}">
          <span class="pgt-practice-card-copy">
            <strong>Day {{ day.label }}</strong>
            <span>{% if day.access %}{{ day.title }} · {{ day.questionCount }} questions · Free · No login{% else %}Coming soon{% endif %}</span>
          </span>
          <img src="/assets/icons/feather/arrow-right.svg" alt="" width="24" height="24">
        </a>
        {% endif %}
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </div>
</section>

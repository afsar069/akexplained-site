---
layout: pgt-layout.njk
title: UP PGT English MCQs
description: Day-wise English Literature practice.
crumb_label: MCQs
pgt_practice_index: true
pgt_practice_hero_title: English MCQs
pgt_practice_collection_label: MCQs
pgt_resources: true
---
<section class="pgt-practice-index" aria-labelledby="pgt-practice-index-title">
  <header class="pgt-practice-intro">
    <div>
      <h2 id="pgt-practice-index-title">Choose your practice day</h2>
      <p>Topics and MCQs are coming soon.</p>
    </div>
    <span>60 days</span>
  </header>
  <div class="pgt-practice-groups">
    {% for group in pgtMcqGroups %}
    <details class="pgt-practice-group"{% if loop.first %} open{% endif %}>
      <summary>
        <img class="pgt-practice-group-icon" src="/assets/icons/tabler/calendar-check.svg" alt="" width="28" height="28">
        <span>Days {{ group.startLabel }}–{{ group.endLabel }}</span>
        <small>10 days</small>
        <img class="pgt-practice-chevron" src="/assets/icons/feather/chevron-down.svg" alt="" width="22" height="22">
      </summary>
      <div class="pgt-practice-card-grid">
        {% for day in group.days %}
        <a class="pgt-practice-card" href="/exams/pgt/up-pgt/mcqs/day-{{ day.number }}/" aria-label="Day {{ day.number }} — coming soon">
          <span class="pgt-practice-card-copy">
            <strong>Day {{ day.label }}</strong>
            <span>Coming soon</span>
          </span>
          <img src="/assets/icons/feather/arrow-right.svg" alt="" width="24" height="24">
        </a>
        {% endfor %}
      </div>
    </details>
    {% endfor %}
  </div>
</section>

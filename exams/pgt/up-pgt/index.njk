---
layout: pgt-layout.njk
title: UP PGT English
description: English Literature study guidance for UP PGT preparation.
crumb_label: UP PGT
pgt_resources: true
---
<section class="pgt-resource-hub" aria-label="UP PGT preparation resources">
  <a class="pgt-course-card" href="/exams/pgt/up-pgt/complete-course/" aria-label="Complete course in 60 days — coming soon">
    <span class="pgt-course-icon" aria-hidden="true"><img src="/assets/icons/tabler/calendar-check.svg" alt="" width="64" height="64"></span>
    <span class="pgt-course-copy">
      <strong>Complete course in 60 days</strong>
      <span>A focused plan for your English preparation.</span>
    </span>
    <span class="pgt-course-action">Coming soon<img src="/assets/icons/feather/arrow-right.svg" alt="" width="24" height="24"></span>
  </a>
  <div class="pgt-resource-grid">
    {% for resource in pgtResources %}{% if resource.slug != 'complete-course' %}
    <a class="pgt-resource-card" href="/exams/pgt/up-pgt/{{ resource.slug }}/" aria-label="{{ resource.title }}{% if resource.slug == 'mcqs' %} — browse 60 days{% elif resource.slug == 'mock-tests' %} — browse 60 tests{% else %} — coming soon{% endif %}">
      <span class="pgt-resource-icon" aria-hidden="true"><img src="/assets/icons/tabler/{{ resource.icon }}.svg" alt="" width="52" height="52"></span>
      <span class="pgt-resource-copy"><strong>{{ resource.title }}</strong><span>{{ resource.description }}</span><span class="pgt-resource-status">{% if resource.slug == 'mcqs' %}Browse 60 days{% elif resource.slug == 'mock-tests' %}Browse 60 tests{% else %}Coming soon{% endif %}</span></span>
      <img class="pgt-resource-arrow" src="/assets/icons/feather/arrow-right.svg" alt="" width="26" height="26">
    </a>
    {% endif %}{% endfor %}
  </div>
  <p class="pgt-guide-link"><a href="/exams/pgt/up-pgt/study-guide/">Read the UP PGT English study guide<img src="/assets/icons/feather/arrow-right.svg" alt="" width="18" height="18"></a></p>
</section>

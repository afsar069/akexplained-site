---
layout: state-psc-layout.njk
permalink: /exams/state-psc/up-assistant-professor/paper-2-mock-tests/index.html
title: Paper 2 English Literature Mock Tests — UP Assistant Professor
crumb_label: Paper 2 English Literature Mock Tests
state_psc_resource: true
eleventyComputed:
  description: "Take Mock Tests {{ statePscMockTests.numbers }} for UP Assistant Professor Paper 2 English Literature{{ statePscMockTests.countPhrase }}. Log in with a free account to open them."
---
{#- The cards come from the paper catalog (_data/paperCatalog.json), so a new mock test needs no edit here. -#}
<section class="pgt-practice-index" aria-labelledby="state-psc-mock-title">
  <header class="pgt-practice-intro">
    <div>
      <h2 id="state-psc-mock-title">Choose a mock test</h2>
      <p>Log in with a free account to take Mock Tests {{ statePscMockTests.numbers }}.</p>
    </div>
    <span>Paper 2</span>
  </header>
  <div class="pgt-practice-groups"><div class="pgt-practice-group">
  <div class="pgt-practice-card-grid state-psc-mock-grid">
    {%- for mock in statePscMockTests.tests %}
    <div class="pgt-practice-card">
      <span class="pgt-practice-card-copy"><strong>Mock Test {{ mock.label }}</strong><span>{{ mock.questionCount }} questions</span></span>
      <a class="agehub-go agehub-go-lock" data-guest-only hidden href="/login/?next={{ mock.url | urlencode }}" aria-label="Mock Test {{ mock.number }} needs a login. Log in to open it." title="Log in to open Mock Test {{ mock.number }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></a>
      <a class="agehub-go is-solid" data-auth-only hidden href="{{ mock.url }}">Start</a>
    </div>
    {%- endfor %}
  </div>
  </div></div>
</section>

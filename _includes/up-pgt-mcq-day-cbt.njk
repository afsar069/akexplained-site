{% extends "mcq-page.njk" %}
{# UP PGT English MCQ day ka CBT page.
   Free days 1–10: public file (data-src), live-day.njk / live-day-review.njk se bante hain.
   Login days (11 se aage): gated-day.njk / gated-day-review.njk se PEHLE hi ban jate hain, sawal
   Supabase mcq_papers me. Self-serve publish (rule 17): data-catalog-check lagta hai, to page tabhi
   khulta hai jab set paper_catalog me LIVE ho; warna "This set is not open yet".
   Jis din ka paper abhi upload hi nahi hua, uska naam aur ginti build ke waqt pata nahi — isliye
   yahan kuch bhi nahi likhte; cbt.js live catalog se asli naam aur ginti bhar deta hai. #}
{% set known = day.title %}
{% set gated = day.managed %}
{% set pageTitle %}UP PGT English MCQs — Day {{ day.number }}{% if known %}: {{ day.title }}{% endif %}{% if examReview %} — Review your answers{% endif %} | AK Explained{% endset %}
{% set pageDescription %}{% if known %}Day {{ day.number }} {{ day.title }}: {{ day.questionCount }} {{ day.levelName | lower }} UP PGT English MCQs in a CBT test. {% if gated %}{% if paidLayer.live %}The All Access pass is required.{% else %}A free login is required.{% endif %}{% else %}Free for everyone, with no login required.{% endif %}{% else %}Day {{ day.number }} of the UP PGT English MCQ practice days. Log in with a free account to take it once it is open.{% endif %}{% endset %}
{% set canonical %}https://akexplained.com/exams/pgt/up-pgt/mcqs/day-{{ day.number }}/{% if examReview %}review/{% endif %}{% endset %}
{% if examReview or not day.liveAtBuild %}{% set robots = "noindex,follow" %}{% endif %}
{% set crumbs = [{t:'Home',h:'/'},{t:'Exams',h:'/exams/'},{t:'PGT English',h:'/exams/pgt/'},{t:'UP PGT',h:'/exams/pgt/up-pgt/'},{t:'MCQs',h:'/exams/pgt/up-pgt/mcqs/'},{t:'Day ' ~ day.number,h:'/exams/pgt/up-pgt/mcqs/day-' ~ day.number ~ '/'}] %}
{% set mainClass = "cbt" %}
{% set scripts = ["/assets/nav.js", "/assets/cbt.js"] %}
{% block main %}
<section class="pagehead pagehead-practice">
  <span class="mark" aria-hidden="true">{{ day.number }}</span>
  <div class="wrap">
    <p class="eyebrow" id="cbtEyebrow">Practice &middot; UP PGT English</p>
    <h1 id="cbtTitle">{% if examReview %}Review your answers{% else %}Day {{ day.number }}{% endif %}</h1>
    <p class="lede" id="cbtLede">{% if examReview %}{% if known %}{{ day.title }} · {% endif %}Your answers, the correct answers, and explanations.{% elif not known %}{% if paidLayer.live %}This set needs the All Access pass.{% else %}Log in with a free account to take this set.{% endif %}{% elif gated %}{{ day.title }} · {{ day.questionCount }} {{ day.levelName | lower }} questions · {% if paidLayer.live %}All Access pass required.{% else %}Free login required.{% endif %}{% else %}{{ day.title }} · {{ day.questionCount }} {{ day.levelName | lower }} questions · Free · No login required.{% endif %}</p>
  </div>
</section>
<div class="cbt-printhead" aria-hidden="true">
  <img src="/assets/logo.png" alt="" width="34" height="34">
  <span><b>AK Explained</b> &middot; The Student's Library<br>akexplained.com</span>
</div>
<div class="wrap cbt-body" data-cbt data-exam-day{% if examReview %} data-mode="review"{% endif %}
     data-set="{{ day.setId }}"
     {% if gated %}data-gated="{{ day.setId }}" data-catalog-check="{{ day.setId }}" data-levels="{{ day.level }}" data-default-level="{{ day.level }}"{% if known %} data-day-title="{{ day.title }}"{% endif %} data-day-level-label="{{ day.levelName | lower }}"{% else %}data-src="/assets/questions/{{ day.questionFile }}"{% endif %}
     data-exam-home="/exams/pgt/up-pgt/"
     data-exam-index-label="UP PGT MCQs"
     data-back="/exams/pgt/up-pgt/mcqs/{% if examReview %}day-{{ day.number }}/{% endif %}"
     data-back-label="{% if examReview %}Day {{ day.number }}{% else %}MCQs{% endif %}">
  <noscript><div class="cbt-start"><h1>This page needs JavaScript</h1><p>Turn on JavaScript and reload to use the test and review screens.</p></div></noscript>
</div>
{% endblock %}

{#- Ek part ka page, Literary Theory aur Cultural Studies dono ke liye (ek hi dhancha).
    Page apne front matter me `part` (pagination alias) deta hai, aur body me ye set karta hai:
      series = { name: "Literary Theory", parts: <poori list>, back: "/literary-criticism/#literary-theory" }
    Live chapter <a> hai, baaki <div>, isliye khol neeche alag-alag hai; andar ka hissa macro me. -#}
{%- macro chbody(ch) -%}
{%- if ch.picture %}
<span class="ltx-thumb"><img src="{{ ch.picture.src }}" srcset="{{ ch.picture.small }} 240w, {{ ch.picture.src }} 480w" sizes="(max-width: 559px) 84px, (max-width: 860px) calc((100vw - 72px) / 2 - 24px), 310px" alt="{{ ch.picture.alt }}" width="480" height="300" loading="lazy"></span>
{%- else %}
<span class="ltx-thumb ltx-thumb-plain" aria-hidden="true"><span class="ltx-fig">{{ ch.n }}</span></span>
{%- endif %}
<span class="ltx-meta">Chapter {{ ch.n }}</span>
<span class="ltx-name">{{ ch.title }}</span>
{%- if ch.people %}
<span class="ltx-sum">{{ ch.people | safe }}</span>
{%- endif %}
{%- if ch.sub %}
<ul class="ltx-subs" aria-label="Topics in this chapter">
{%- for t in ch.sub %}
<li>{{ t | safe }}</li>
{%- endfor %}
</ul>
{%- endif %}
{%- endmacro -%}

<section class="pagehead">
  <span class="mark" aria-hidden="true">{{ part.number }}</span>
  <div class="wrap">
    <p class="eyebrow">{{ series.name }} · Part {{ part.number }} of {{ series.parts | length }}</p>
    <h1>{{ part.name }}</h1>
    <p class="lede">{{ part.summary }}</p>
  </div>
</section>

<section style="border-top:1px solid var(--border)">
  <div class="wrap">
    <p class="ltx-back"><a href="{{ series.back }}">&larr; All parts</a></p>
    <h2>Chapters in this part</h2>
    <p>{% if part.count == 1 %}One chapter{% else %}{{ part.count }} chapters{% endif %}, in order. Each chapter is one article. It opens with the thinkers of that school, and every name leads to a page of its own.</p>
    <ol class="grid ltx-chcards">
      {%- for ch in part.chapters %}
      <li>
        {%- if ch.live %}
        <a class="ltx-card{% if ch.sub %} ltx-has-subs{% endif %}" href="/notes/{{ ch.slug }}/">
          {{ chbody(ch) }}
          <span class="ltx-cta"><span class="ltx-ch-go">Read</span></span>
        </a>
        {%- else %}
        <div class="ltx-card ltx-card-soon{% if ch.sub %} ltx-has-subs{% endif %}">
          {{ chbody(ch) }}
          <span class="ltx-cta"><span class="ltx-ch-soon">Coming soon</span></span>
        </div>
        {%- endif %}
      </li>
      {%- endfor %}
    </ol>
    {%- if part.liveCount == 0 %}
    <p class="meta" style="margin-top:16px">Articles coming soon</p>
    {%- endif %}
  </div>
</section>

<section style="background:linear-gradient(180deg,var(--cream),var(--bg));border-top:1px solid var(--border)">
  <div class="wrap">
    <nav class="ltx-nav" aria-label="Other parts">
      {%- if part.prev %}
      <a class="ltx-nav-link" href="{{ part.prev.href }}">
        <span>&larr; Part {{ part.prev.number }}</span><strong>{{ part.prev.name }}</strong>
      </a>
      {%- else %}<span></span>{%- endif %}
      {%- if part.next %}
      <a class="ltx-nav-link ltx-nav-next" href="{{ part.next.href }}">
        <span>Part {{ part.next.number }} &rarr;</span><strong>{{ part.next.name }}</strong>
      </a>
      {%- else %}<span></span>{%- endif %}
    </nav>
  </div>
</section>

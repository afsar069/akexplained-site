{# The "Important Links" band (CLAUDE.md rules 19 to 22). Needs `hubLinksText` set before the include. Optional `hubLinksSkip` = a path to leave out (the page's own link). List: _data/hubLinks.json #}
<section class="hub-links" aria-labelledby="hubLinksTitle">
  <div class="wrap">
    <div class="sechead">
      <h2 id="hubLinksTitle">Important Links</h2>
    </div>
    <p class="seclede">{{ hubLinksText }}</p>
    <ul class="hub-linklist">
{% for l in hubLinks %}{% if l.href != hubLinksSkip %}
      <li>
        <a class="hub-link" href="{{ l.href }}">
          <span class="hub-link-txt">
            <strong>{{ l.title }}</strong>
            <span>{{ l.text }}</span>
          </span>
          <span class="hub-link-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </li>
{% endif %}{% endfor %}
    </ul>
  </div>
</section>

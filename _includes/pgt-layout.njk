<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | AK Explained</title>
<meta name="description" content="{{ description }}">
{% if (coming_soon and not (mockTest and mockTest.live)) or pgt_review %}<meta name="robots" content="noindex,follow">{% endif %}
<link rel="canonical" href="https://akexplained.com{{ page.url }}">
<link rel="icon" href="/assets/logo.png" type="image/png">
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/pgt.css">
</head>
<body class="pgt-page">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"></header>
<div class="wrap pgt-breadcrumb"><p class="crumb"><a href="/">Home</a><span>/</span><a href="/exams/">Exams</a><span>/</span>{% if pgt_hub %}PGT English{% elif pgt_practice_index or pgt_practice_item %}<a href="/exams/pgt/">PGT English</a><span>/</span><a href="/exams/pgt/up-pgt/">UP PGT</a><span>/</span>{% if pgt_practice_item %}<a href="{{ pgt_practice_collection_url }}">{{ pgt_practice_collection_label }}</a><span>/</span>{% endif %}{{ crumb_label or title }}{% else %}<a href="/exams/pgt/">PGT English</a><span>/</span>{{ crumb_label or title }}{% endif %}</p></div>
<main id="main"{% if not pgt_hub %} class="pgt-detail{% if pgt_resources %} pgt-detail-resources{% endif %}{% if pgt_cbt and (not mockTest or mockTest.live) %} cbt{% endif %}"{% endif %}>
{% if not pgt_hub %}
  <div class="wrap pgt-detail-nav">
    <a class="pgt-back" href="{% if pgt_practice_item %}{{ pgt_practice_collection_url }}{% elif pgt_practice_index %}/exams/pgt/up-pgt/{% else %}/exams/pgt/{% endif %}"><img src="/assets/icons/feather/arrow-left.svg" alt="" width="18" height="18">{% if pgt_practice_item %}Back to {{ pgt_practice_collection_label }}{% elif pgt_practice_index %}Back to UP PGT{% else %}Back to PGT exams{% endif %}</a>
  </div>
  <section class="pgt-hero pgt-hero-detail{% if pgt_practice_index %} pgt-practice-hero{% endif %}" aria-labelledby="{% if pgt_cbt and (not mockTest or mockTest.live) %}cbtTitle{% else %}pgt-detail-title{% endif %}">
    <picture class="pgt-hero-art" aria-hidden="true">
      {% if pgt_practice_index %}
      <source type="image/webp" srcset="/assets/exams/pgt-mcq-press-1200.webp 1200w, /assets/exams/pgt-mcq-press-1800.webp 1800w" sizes="(min-width:1024px) calc(100vw - 272px), 100vw">
      <img src="/assets/exams/pgt-mcq-press-1800.webp" alt="" width="1800" height="640" fetchpriority="high" decoding="async">
      {% else %}
      <source type="image/webp" srcset="/assets/exams/pgt-hero-1200.webp 1200w, /assets/exams/pgt-hero-1800.webp 1800w" sizes="(min-width:1024px) calc(100vw - 272px), 100vw">
      <img src="/assets/exams/pgt-hero-1800.webp" alt="" width="1800" height="640" fetchpriority="high" decoding="async">
      {% endif %}
    </picture>
    <div class="wrap pgt-hero-inner">
      <div class="pgt-hero-copy">
        {% if pgt_practice_index %}<h1 id="pgt-detail-title"><span>UP PGT</span><span>{{ pgt_practice_hero_title }}</span></h1>{% else %}<p class="eyebrow"{% if pgt_cbt and (not mockTest or mockTest.live) %} id="cbtEyebrow"{% endif %}>Uttar Pradesh · UPESSC</p><h1 id="{% if pgt_cbt and (not mockTest or mockTest.live) %}cbtTitle{% else %}pgt-detail-title{% endif %}">{{ title }}</h1>{% endif %}
        <p class="pgt-hero-description"{% if pgt_cbt and (not mockTest or mockTest.live) %} id="cbtLede"{% endif %}>{{ description }}</p>
      </div>
    </div>
  </section>
  <div class="wrap pgt-detail-body">
{% endif %}
{{ content | safe }}
{% if not pgt_hub %}</div>{% endif %}
</main>
<footer class="site-footer"></footer>
{% if pgt_cbt and (not mockTest or mockTest.live) %}<script src="/assets/cbt.js" defer></script>{% endif %}
</body>
</html>

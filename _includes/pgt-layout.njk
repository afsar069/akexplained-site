<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | AK Explained</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://akexplained.com{{ page.url }}">
<link rel="icon" href="/assets/logo.png" type="image/png">
<link rel="stylesheet" href="/assets/site.css">
<link rel="stylesheet" href="/assets/pgt.css">
</head>
<body class="pgt-page">
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"></header>
<div class="wrap pgt-breadcrumb"><p class="crumb"><a href="/">Home</a><span>/</span><a href="/exams/">Exams</a><span>/</span>{% if pgt_hub %}PGT English{% else %}<a href="/exams/pgt/">PGT English</a><span>/</span>{{ crumb_label or title }}{% endif %}</p></div>
<main id="main"{% if not pgt_hub %} class="wrap pgt-detail"{% endif %}>
{% if not pgt_hub %}
  <header class="pgt-detail-head">
    <a class="pgt-back" href="/exams/pgt/"><img src="/assets/icons/feather/arrow-left.svg" alt="" width="18" height="18">Back to PGT exams</a>
    <p class="eyebrow">Uttar Pradesh · UPESSC</p>
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
  </header>
{% endif %}
{{ content | safe }}
</main>
<footer class="pgt-footer wrap">
  <p>&copy; 2026 AK Explained. All rights reserved.</p>
  <p>Prof. Afsar Khan</p>
</footer>
</body>
</html>

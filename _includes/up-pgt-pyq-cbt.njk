{% extends "mcq-page.njk" %}
{# UP PGT English PYQ (previous-year paper) CBT page (CLAUDE.md rule 23).
   `pyq` aliases one paper of _data/pgtPyqPapers.js; the test and review routes are made from it
   (exams/pgt/up-pgt/pyqs/test.njk and review.njk), so a new year needs nothing here.
   FREE, no login: the questions are the public file assets/questions/<setId>.json. Same engine as the NET PYQs
   (data-exam-pyq in assets/cbt.js). The review page is noindex. #}
{% set base = "/exams/pgt/up-pgt/pyqs/" %}
{% set pageTitle %}{{ pyq.title }}{% if examReview %} — Review your answers{% endif %} | AK Explained{% endset %}
{% set pageDescription %}Take the {{ pyq.title }} as an online test with {{ pyq.count }} questions, a clock and a full answer review. Free, with no login required.{% endset %}
{% set canonical %}https://akexplained.com{{ pyq.href }}{% if examReview %}review/{% endif %}{% endset %}
{% if examReview %}{% set robots = "noindex,follow" %}{% endif %}
{% set crumbs = [{t:'Home',h:'/'},{t:'Exams',h:'/exams/'},{t:'PGT English',h:'/exams/pgt/'},{t:'UP PGT',h:'/exams/pgt/up-pgt/'},{t:'PYQs',h:base},{t:pyq.title,h:pyq.href}] %}
{% set mainClass = "cbt" %}
{% set scripts = ["/assets/nav.js", "/assets/cbt.js"] %}
{% block main %}
<section class="pagehead pagehead-practice">
  <span class="mark" aria-hidden="true">{{ pyq.year }}</span>
  <div class="wrap">
    <p class="eyebrow" id="cbtEyebrow">Practice &middot; UP PGT English &middot; Previous-year paper</p>
    <h1 id="cbtTitle">{% if examReview %}Review your answers{% else %}{{ pyq.title }}{% endif %}</h1>
    <p class="lede" id="cbtLede">{% if examReview %}Your answer, the right one, and the explanation for each question.{% else %}{{ pyq.count }} questions. Free for everyone, with no login required.{% endif %}</p>
  </div>
</section>
<div class="cbt-printhead" aria-hidden="true">
  <img src="/assets/logo.png" alt="" width="34" height="34">
  <span><b>AK Explained</b> &middot; The Student's Library<br>akexplained.com</span>
</div>
<div class="wrap cbt-body" data-cbt data-exam-pyq{% if examReview %} data-mode="review"{% endif %}
     data-set="{{ pyq.setId }}" data-src="/assets/questions/{{ pyq.setId }}.json"
     data-exam-home="/exams/pgt/up-pgt/" data-exam-home-label="UP PGT English preparation"
     data-exam-index-label="UP PGT English PYQs"
     data-suggest-href="/exams/pgt/up-pgt/syllabus-download/" data-suggest-label="UP PGT English syllabus" data-suggest-note="Download the syllabus PDFs"
     data-back="{{ base }}{% if examReview %}{{ pyq.slug }}/{% endif %}"
     data-back-label="{% if examReview %}the paper{% else %}UP PGT English PYQs{% endif %}">
  <noscript><div class="cbt-start"><h2>This page needs JavaScript</h2><p>Turn on JavaScript and reload to use the test and review screens.</p></div></noscript>
</div>
<div class="wrap"><p class="pgt-pyq-disclaimer">{% include "pgt-pyq-disclaimer.njk" %}</p></div>
{% endblock %}

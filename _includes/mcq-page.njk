<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle | safe }}</title>
<meta name="description" content="{{ pageDescription | safe }}">
<link rel="canonical" href="{{ canonical }}">
{% if robots %}<meta name="robots" content="{{ robots }}">
{% endif %}{% if ogTitle %}<meta property="og:title" content="{{ ogTitle | safe }}">
<meta property="og:description" content="{{ ogDescription | safe }}">
<meta property="og:image" content="https://akexplained.com/assets/social-card.png">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:type" content="website">
<meta name="twitter:card" content="summary_large_image">
{% endif %}<link rel="icon" href="/assets/logo.png" type="image/png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/site.css">
{% if jsonld %}<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":"https://akexplained.com/"},
{"@type":"ListItem","position":2,"name":"Quizzes","item":"https://akexplained.com/quizzes/"},
{"@type":"ListItem","position":3,"name":"MCQ Practice","item":"https://akexplained.com/quizzes/mcq/"},
{"@type":"ListItem","position":4,"name":"{{ age.name }}","item":"https://akexplained.com/quizzes/mcq/{{ age.slug }}/"}]}
</script>
{% endif %}</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<!-- Header aur footer yahan khali hain: eleventy.config.js (syncChrome) base.njk wala asli header/footer laga deta hai. -->
<header class="site-header"></header>
<div class="wrap"><p class="crumb">{% for c in crumbs %}{% if not loop.first %}<span>/</span>{% endif %}{% if c.h %}<a href="{{ c.h }}">{{ c.t | safe }}</a>{% else %}{{ c.t | safe }}{% endif %}{% endfor %}</p></div>
<main id="main"{% if mainClass %} class="{{ mainClass }}"{% endif %}>
{% block main %}{% endblock %}
</main>

<footer class="site-footer"></footer>
{% for s in scripts %}<script src="{{ s }}" defer></script>
{% endfor %}</body>
</html>

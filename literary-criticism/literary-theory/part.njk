---
layout: literary-theory-layout.njk
pagination:
  data: literaryTheory
  size: 1
  alias: part
permalink: "/literary-criticism/literary-theory/{{ part.slug }}/index.html"
eleventyComputed:
  title: "{{ part.name }}"
  description: "{{ part.summary }} Part {{ part.number }} of the Literary Theory notes, with {{ part.count }} chapters, for BA, MA and UGC-NET students."
  crumb_label: "{{ part.name }}"
---
<section class="pagehead">
  <span class="mark" aria-hidden="true">{{ part.number }}</span>
  <div class="wrap">
    <p class="eyebrow">Literary Theory · Part {{ part.number }} of 8</p>
    <h1>{{ part.name }}</h1>
    <p class="lede">{{ part.summary }}</p>
  </div>
</section>

<section style="border-top:1px solid var(--border)">
  <div class="wrap">
    <p class="ltx-back"><a href="/literary-criticism/#literary-theory">&larr; All eight parts</a></p>
    <h2>Chapters in this part</h2>
    <p>{% if part.count == 1 %}One chapter{% else %}{{ part.count }} chapters{% endif %}, in order. Each chapter is one article. It opens with the thinkers of that school, and every name leads to a page of its own.</p>
    <ol class="ltx-chapters" style="margin-top:18px">
      {%- for ch in part.chapters %}
      {%- if ch.live %}
      <li class="ltx-ch is-live">
        <span class="ltx-ch-no" aria-hidden="true">{{ ch.n }}</span>
        <span class="ltx-ch-txt">
          <strong><a href="/notes/{{ ch.slug }}/">{{ ch.title }}</a></strong>
          {%- if ch.people %}
          <span class="ltx-who">{{ ch.people | safe }}</span>
          {%- endif %}
        </span>
        <a class="ltx-ch-go" href="/notes/{{ ch.slug }}/">Read</a>
      </li>
      {%- else %}
      <li class="ltx-ch">
        <span class="ltx-ch-no" aria-hidden="true">{{ ch.n }}</span>
        <span class="ltx-ch-txt">
          <strong>{{ ch.title }}</strong>
          {%- if ch.people %}
          <span class="ltx-who">{{ ch.people | safe }}</span>
          {%- endif %}
        </span>
        <span class="ltx-ch-soon">Coming soon</span>
      </li>
      {%- endif %}
      {%- endfor %}
    </ol>
    {%- if part.liveCount == 0 %}
    <p class="meta" style="margin-top:16px">Articles coming soon</p>
    {%- endif %}
  </div>
</section>

<section style="background:linear-gradient(180deg,var(--cream),var(--bg));border-top:1px solid var(--border)">
  <div class="wrap">
    <nav class="ltx-nav" aria-label="Other parts">
      {%- if part.prev %}
      <a class="ltx-nav-link" href="{{ part.prev.href }}">
        <span>&larr; Part {{ part.prev.number }}</span><strong>{{ part.prev.name }}</strong>
      </a>
      {%- else %}<span></span>{%- endif %}
      {%- if part.next %}
      <a class="ltx-nav-link ltx-nav-next" href="{{ part.next.href }}">
        <span>Part {{ part.next.number }} &rarr;</span><strong>{{ part.next.name }}</strong>
      </a>
      {%- else %}<span></span>{%- endif %}
    </nav>
  </div>
</section>
